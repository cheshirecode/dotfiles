#!/usr/bin/env bash
# Run bin/leak-guard.sh --staged; block the commit on findings.
# Wired by bin/install-hooks.sh --write. Bypass: DOTFILES_NO_HOOK=1.
# Absent or non-executable guard exits 0 rather than blocking.

set -uo pipefail

[ "${DOTFILES_NO_HOOK:-0}" = "1" ] && exit 0

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
GUARD="$ROOT/bin/leak-guard.sh"
[ -x "$GUARD" ] || exit 0   # absent guard must not block a commit

if ! "$GUARD" --staged; then
  echo "pre-commit: refusing this commit. Fix the lines above, or run with" >&2
  echo "            DOTFILES_NO_HOOK=1 if the exception is deliberate." >&2
  exit 1
fi
