#!/usr/bin/env bash
# Gate a push by destination. A remote marked private
# (`git config remote.<name>.dotfiles-private true`, machine-local) may carry
# private content; every other remote is public and must pass
# bin/leak-guard.sh --range and gitleaks over every commit it would gain.
# Unmarked means public: a forgotten mark blocks a push, it never leaks one.
# Wired by bin/install-hooks.sh --write. Bypass: DOTFILES_NO_HOOK=1.

set -uo pipefail

[ "${DOTFILES_NO_HOOK:-0}" = "1" ] && exit 0

REMOTE="$1"
ZERO=0000000000000000000000000000000000000000
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
GUARD="$ROOT/bin/leak-guard.sh"

if [ "$(git config --bool --get "remote.$REMOTE.dotfiles-private" 2>/dev/null)" = "true" ]; then
  exit 0
fi

# Public from here on: a missing scanner blocks rather than waves through.
[ -x "$GUARD" ] || { echo "pre-push: $GUARD missing; refusing a public push" >&2; exit 1; }
command -v gitleaks >/dev/null 2>&1 || { echo "pre-push: gitleaks missing; refusing a public push" >&2; exit 1; }

fail=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue   # a delete publishes nothing
  # Everything the remote does not already have. A new branch has no remote
  # sha, so exclude every ref we know the remote holds.
  if [ "$rsha" = "$ZERO" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    revs=("$lsha" --not "--remotes=$REMOTE")
  else
    revs=("$rsha..$lsha")
  fi
  n=$(git rev-list --count "${revs[@]}") || { fail=1; continue; }
  [ "$n" = 0 ] && continue
  echo "pre-push: $REMOTE is public; scanning $n commit(s)" >&2
  "$GUARD" --range "${revs[@]}" || fail=1
  if [ "${#revs[@]}" = 1 ]; then opts="${revs[0]}"; else opts="$lsha --not --remotes=$REMOTE"; fi
  gitleaks git --no-banner --log-level warn --redact --log-opts="$opts" "$ROOT" >&2 || fail=1
done

if [ "$fail" != 0 ]; then
  echo "pre-push: refusing to publish to $REMOTE. Push only the clean commits" >&2
  echo "          (see docs/two-upstreams.md), or mark a private remote with" >&2
  echo "          git config remote.$REMOTE.dotfiles-private true" >&2
  exit 1
fi
