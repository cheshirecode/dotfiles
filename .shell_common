#!/bin/sh
# Common shell configuration shared between bash and zsh
# Sourced by both ~/.bashrc and ~/.zshrc

#------------------------------------------////
# Colors:
#------------------------------------------////
black='\e[0;30m'
blue='\e[0;34m'
green='\e[0;32m'
cyan='\e[0;36m'
red='\e[0;31m'
IP_DEVICE='eth0'

#------------------------------------------////
## FUNCTIONS
#------------------------------------------////

welcome() {
    #------------------------------------------
    #------WELCOME MESSAGE---------------------
    # customize this first message with a message of your choice.
    # this will display the username, date, time, a calendar, the amount of users, and the up time.
    #clear
    # Gotta love ASCII art with figlet
    if command -v figlet >/dev/null 2>&1; then
        figlet "Welcome, " "$USER"
    else
        echo "Welcome, $USER"
    fi
    #toilet "Welcome, " $USER;
    printf "\n"
    if command -v cal >/dev/null 2>&1; then
        cal
    fi
    printf "Today is "
    date
    printf "\n"
    printf "Up time:"
    uptime | awk /'up/'
    printf "Local IP Address :"
    if command -v ip >/dev/null 2>&1; then
        ip -4 addr show ${IP_DEVICE} 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1
    elif command -v ifconfig >/dev/null 2>&1; then
        ifconfig ${IP_DEVICE} 2>/dev/null | awk /'inet / {print $2}' | sed -e s/addr:/' '/
    else
        echo "N/A"
    fi
    echo ""
}

# get IP adresses
my_ip() {
    if command -v ip >/dev/null 2>&1; then
        MY_IP=$(ip -4 addr show ${IP_DEVICE} 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1)
    elif command -v ifconfig >/dev/null 2>&1; then
        MY_IP=$(ifconfig ${IP_DEVICE} 2>/dev/null | awk /'inet addr/ {print $2}')
    fi
}

# get current host related info
ii() {
    printf "\nYou are logged on ${red}$HOST"
    printf "\nAdditionnal information: "
    uname -a
    printf "\n${red}Users logged on: "
    w -h
    printf "\n${red}Current date : "
    date
    printf "\n${red}Machine stats : "
    uptime
    printf "\n${red}Memory stats : "
    free
    printf "\n${red}Local IP Address :"
    if command -v ip >/dev/null 2>&1; then
        ip -4 addr show ${IP_DEVICE} 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1
    elif command -v ifconfig >/dev/null 2>&1; then
        ifconfig ${IP_DEVICE} 2>/dev/null | awk /'inet / {print $2}' | sed -e s/addr:/' '
    else
        echo "N/A"
    fi
    echo
}

# Easy extract
extract() {
    if [ -f "$1" ]; then
        case $1 in
        *.tar.bz2) tar xvjf "$1" ;;
        *.tar.gz) tar xvzf "$1" ;;
        *.bz2)
            if command -v bunzip2 >/dev/null 2>&1; then
                bunzip2 "$1"
            else
                echo "bunzip2 not found. Install bzip2 package."
            fi
            ;;
        *.rar)
            if command -v unrar >/dev/null 2>&1; then
                unrar x "$1"
            elif command -v rar >/dev/null 2>&1; then
                rar x "$1"
            else
                echo "unrar/rar not found. Install unrar package."
            fi
            ;;
        *.gz) gunzip "$1" ;;
        *.tar) tar xvf "$1" ;;
        *.tbz2) tar xvjf "$1" ;;
        *.tgz) tar xvzf "$1" ;;
        *.zip)
            if command -v unzip >/dev/null 2>&1; then
                unzip "$1"
            else
                echo "unzip not found. Install unzip package."
            fi
            ;;
        *.Z) uncompress "$1" ;;
        *.7z)
            if command -v 7z >/dev/null 2>&1; then
                7z x "$1"
            else
                echo "7z not found. Install p7zip-full package."
            fi
            ;;
        *) echo "don't know how to extract '$1'..." ;;
        esac
    else
        echo "'$1' is not a valid file!"
    fi
}

upinfo() {
    printf "${green}${HOST}${HOSTNAME} ${red}uptime is ${cyan} \t "
    uptime | awk /'up/ {print $3,$4,$5,$6,$7,$8,$9,$10}'
}

# Makes directory then moves into it
mkcdr() {
    mkdir -p -v "$1"
    cd "$1" || exit
}

# kill all by name https://stackoverflow.com/a/30515012
killAllByName() {
    ps -ef | grep "$1" | grep -v grep | awk '{print $2}' | xargs -r kill -9
}

#------------------------------------------////
## ALIASES
#------------------------------------------////

# ls aliases
alias ll='ls -alF'
alias la='ls -a'

# Utility aliases
alias biggest='BLOCKSIZE=1048576; du -x | sort -nr | head -10'
alias wget='wget -c'
alias trash='mv -t ~/.local/share/Trash/files'
alias ps-aux='ps axo user:20,pid,pcpu,pmem,vsz,rss,tty,stat,start,time,comm'

# Docker helper methods
alias docker-cleanup='docker container prune -f; docker image prune -f; docker rmi $(docker images --quiet --filter "dangling=true"); docker volume prune -f ; docker system prune -f;'

# Claude Code alias
alias claude-yolo='claude --dangerously-skip-permissions'

#------------------------------------------////
## ENVIRONMENT VARIABLES
#------------------------------------------////

export http_proxy= #"Page on 168"

# NVM setup
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion

# Add local bin to PATH
export PATH="$HOME/.local/bin:$PATH"

# de-dupe PATH (works in both bash and zsh)
if command -v perl >/dev/null 2>&1; then
    PATH="$(perl -e 'print join(":", grep { not $seen{$_}++ } split(/:/, $ENV{PATH}))')"
fi

# GitHub Token - SECURITY WARNING: Do not store tokens in plaintext!
# Consider using a credential manager or environment-specific config
# export GITHUB_TOKEN="your_token_here"
if [ -f "$HOME/.github_token" ]; then
    GITHUB_TOKEN=$(cat "$HOME/.github_token")
    export GITHUB_TOKEN
fi

# SSH agent (with conditional check for file existence)
if [ -f "$HOME/.ssh-agent.sh" ]; then
    . "$HOME/.ssh-agent.sh"
fi

# Per-machine overrides (uncommitted): env vars, paths, secrets specific to
# this host. e.g. worklog WORKLOG_REPO/WORKLOG_BIN exports.
if [ -f "$HOME/.shell_common.local" ]; then
    # shellcheck source=/dev/null
    . "$HOME/.shell_common.local"
fi

# Call welcome message unless an agent/script asks for clean shell output.
if [ "${DOTFILES_QUIET:-0}" != "1" ]; then
    welcome
fi

# --- clear terminal reporting modes before each prompt ----------------------
# A TUI killed abruptly (Ctrl+C, dropped SSH, laptop sleep) exits without
# disabling the focus (1004) and mouse (1000/1002/1003 + SGR 1006) reporting
# it turned on. Nothing then consumes those reports, so every mouse click and
# focus change lands at the prompt as ^[[I / ^[[O / ^[[<35;..M. Resetting per
# prompt makes a stranded terminal self-healing.
#
# Lives here rather than in .bashrc so zsh gets it too: zsh has no
# PROMPT_COMMAND, it uses precmd hooks, and both shells source this file.
# Cheap: one printf of a few bytes, interactive terminals only.
if [ -t 1 ]; then
    _reset_reporting() {
        printf '\033[?1004l\033[?1003l\033[?1002l\033[?1000l\033[?1006l\033[?1015l\033[?1005l'
    }
    if [ -n "$ZSH_VERSION" ]; then
        autoload -Uz add-zsh-hook 2>/dev/null && add-zsh-hook precmd _reset_reporting
    elif [ -n "$BASH_VERSION" ]; then
        case "$PROMPT_COMMAND" in
            *_reset_reporting*) ;;
            "") PROMPT_COMMAND="_reset_reporting" ;;
            *)  PROMPT_COMMAND="_reset_reporting;$PROMPT_COMMAND" ;;
        esac
    fi
fi
# --- end reporting-mode reset ----------------------------------------------
