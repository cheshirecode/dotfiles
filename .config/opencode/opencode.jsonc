{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.2",
  "small_model": "openrouter/deepseek/deepseek-v4.1-flash",
  "agent": {
    "plan": {
      "model": "openrouter/~anthropic/claude-opus-latest"
    },
    "vision": {
      "mode": "subagent",
      "model": "openrouter/z-ai/glm-4.6v",
      "description": "Vision reviewer: inspects screenshots, rendered UI, and design quality. Read-only.",
      "prompt": "You review images: screenshots of web UI, design mockups, rendered states. Read the image files given to you. Judge hierarchy, spacing, contrast, alignment, and kid-appropriateness where asked. Return findings as a list with the image reference, what is wrong, severity, and a one-line fix. You do not edit files.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "coder": {
      "mode": "subagent",
      "model": "openrouter/z-ai/glm-5.2",
      "description": "Implementation lane for multi-file code changes and fixes.",
      "prompt": "You implement exactly the specified changes and run the given verification gates. Report diff stat, gate exit codes, and anything you could not apply. You do not commit unless told to.",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "mechanic": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
      "description": "Cheap lane for mechanical edits, doc hygiene, and bounded sweeps.",
      "prompt": "You perform mechanical, fully-specified edits and simple verification runs. Report what changed and gate exit codes. You do not commit unless told to.",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    }
  },
  "shell": "/bin/zsh",
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "tail_turns": 10
  },
  "skills": {
    "paths": [
      "{env:HOME}/.claude/skills",
      "{env:HOME}/.agents/skills"
    ]
  },
  "mcp": {
    "paper": {
      "type": "local",
      "command": ["{env:PAPER_BIN}", "mcp"],
      "enabled": true
    },
    "worklog-memory": {
      "type": "local",
      "command": ["node", "{env:WORKLOG_MCP_SERVER}"],
      "environment": {
        "WORKLOG_REPO": "{env:WORKLOG_REPO}"
      },
      "enabled": true
    },
    "gdrive": {
      "type": "local",
      "command": ["npx", "-y", "@isaacphi/mcp-gdrive"],
      "enabled": true,
      "environment": {
        "CLIENT_ID": "613313731108-qvpjs130js8lpoupm68knifbebvcec40.apps.googleusercontent.com",
        "CLIENT_SECRET": "{env:GDRIVE_CLIENT_SECRET}",
        "GDRIVE_CREDS_DIR": "{env:HOME}/.config/gdrive-mcp"
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "task": "allow",
    "external_directory": {
      "~/secrets/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/**": "allow",
      "/tmp/**": "allow",
      "*": "ask"
    },
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git show*": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "which *": "allow",
      "cat *": "allow",
      "pnpm test*": "allow",
      "pnpm run test*": "allow",
      "pnpm check*": "allow",
      "pnpm format*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "pytest*": "allow",
      "python3 *": "allow",
      "node *": "allow",
      "cargo test*": "allow",
      "cargo check*": "allow",
      "ruff *": "allow",
      "prettier *": "allow",
      "*": "ask"
    }
  }
}
