SCHEMA_VERSION = 1
STALE_AFTER_SECONDS = 3 * 24 * 60 * 60
VERY_STALE_AFTER_SECONDS = 5 * 24 * 60 * 60
ENVS = {"codex", "cursor", "claude", "opencode", "openrouter", "unknown"}
PROVIDERS = {"codex", "cursor", "claude", "opencode", "openrouter"}
OPENROUTER_MODELS_URL = "https://openrouter.ai/api/v1/models"
# The which-model skill runs inside an LLM session and never holds an Anthropic API
# key: the session itself can list models and inject that JSON via
# WHICH_MODEL_CATALOG_SOURCE. With no injection we build from the dated docs snapshot
# below (IDs + pricing/limits), so the claude catalog works offline and key-free.
# Provenance, not a snapshot date: every Claude id, price, context window and
# max-output figure below is transcribed from the claude-api reference bundled with
# this harness (its shared/models.md and shared/model-migration.md). That reference
# carries no publication date, so the age of the data is genuinely unknown. We say so
# instead of stamping a date the data never had, and an undated source is always
# treated as stale so it can never be presented as current.
ANTHROPIC_REFERENCE = "bundled claude-api reference (shared/models.md, shared/model-migration.md)"
UNKNOWN_DATA_AGE = "unknown"
# Hand-written ENV_SEEDS below carry no live source; this is the date they were
# last curated. Staleness is computed from the data date, not from build time.
SEED_DATA_AS_OF = "2026-01-21"


