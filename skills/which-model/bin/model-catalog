def anthropic_metadata(model_id: str) -> dict | None:
    lowered = model_id.lower()
    for needles, metadata in ANTHROPIC_MODEL_METADATA:
        if any(needle in lowered for needle in needles):
            return metadata
    return None


# Offline mirror of the Claude model tables in ANTHROPIC_REFERENCE, used when the LLM
# session does not inject a live Models API result. IDs are chosen to match the metadata
