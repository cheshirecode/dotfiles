#!/usr/bin/env bash
# Refuse a commit whose author email domain is not this vault's.
#
#   WORKLOG_IDENTITY_DOMAIN   domain this vault accepts; else the clone's
#                             `git config worklog.identityDomain` (set by
#                             bootstrap.sh, read by shells with no direnv);
#                             both unset = report and skip
#   WORKLOG_NO_IDENTITY_HOOK=1  bypass once
#
# Reads the resolved author via `git var GIT_AUTHOR_IDENT`, so GIT_AUTHOR_EMAIL
# env wins over config exactly as git resolves it.

set -uo pipefail

[ "${WORKLOG_NO_IDENTITY_HOOK:-0}" = "1" ] && exit 0

want="${WORKLOG_IDENTITY_DOMAIN:-$(git config --local --get worklog.identityDomain 2>/dev/null || true)}"
if [ -z "$want" ]; then
  echo "note: WORKLOG_IDENTITY_DOMAIN unset (no worklog.identityDomain either); author-identity check skipped." >&2
  echo "      Run: git config worklog.identityDomain <domain>   to enforce one identity per vault." >&2
  exit 0
fi

email="$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -n 's/.*<\([^>]*\)>.*/\1/p')"
case "$email" in
  *"@$want") exit 0 ;;
esac

echo "pre-commit: author email '$email' does not match this vault." >&2
echo "            This vault accepts @$want (WORKLOG_IDENTITY_DOMAIN)." >&2
echo "            Fix the identity rather than committing under the wrong one:" >&2
echo "              check this vault's .envrc exports the right GIT_AUTHOR_EMAIL" >&2
echo "            Deliberate exception: WORKLOG_NO_IDENTITY_HOOK=1 git commit ..." >&2
exit 1
