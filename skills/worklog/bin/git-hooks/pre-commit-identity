#!/usr/bin/env bash
# Refuse a commit whose author email does not belong to THIS vault.
#
# The two vaults cross-contaminated: the work vault carries 795 commits authored
# by the personal identity and 210 by oss@local, while the personal vault
# carries 37 authored by the work identity. Measured 2026-09-16 across all refs.
# Both are private, so that is hygiene rather than exposure - but
# every one of those commits was preventable at commit time, and rewriting
# 6545 commits shared across live worktrees to fix it afterwards is not.
#
# Policy, derived from the vault rather than hardcoded per machine:
#   WORKLOG_IDENTITY_DOMAIN  the email domain this vault accepts
# If unset, the check is REPORTED and skipped, never silently passed - an
# unconfigured identity gate that stays quiet is the failure it exists to stop.
#
# Bypass once: WORKLOG_NO_IDENTITY_HOOK=1 git commit ...
set -uo pipefail

[ "${WORKLOG_NO_IDENTITY_HOOK:-0}" = "1" ] && exit 0

want="${WORKLOG_IDENTITY_DOMAIN:-}"
if [ -z "$want" ]; then
  echo "note: WORKLOG_IDENTITY_DOMAIN unset; author-identity check skipped." >&2
  echo "      Set it in this vault's .envrc to enforce one identity per vault." >&2
  exit 0
fi

email="$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -n 's/.*<\([^>]*\)>.*/\1/p')"
case "$email" in
  *"@$want") exit 0 ;;
esac

echo "pre-commit: author email '$email' does not match this vault." >&2
echo "            This vault accepts @$want (WORKLOG_IDENTITY_DOMAIN)." >&2
echo "            Fix the identity rather than committing under the wrong one:" >&2
echo "              check this vault's .envrc exports the right GIT_AUTHOR_EMAIL" >&2
echo "            Deliberate exception: WORKLOG_NO_IDENTITY_HOOK=1 git commit ..." >&2
exit 1
