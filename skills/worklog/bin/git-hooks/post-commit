#!/usr/bin/env bash
# Worklog post-commit advisory. Fires after every commit (checkpoint, archive,
# autosave, hand-typed git — all paths). TTL-gated so the cross-task lint runs
# at most hourly; otherwise the stamp-file mtime gates it out instantly.
#
# Output: cross-task warning / error counts on stderr. Never blocks.
# Inspect details with the skill `lint.sh --cross-task` or `/worklog lint --cross-task`.
#
# Bypass: `WORKLOG_NO_HOOK=1 git commit ...` (same env as pre-commit).

set -euo pipefail

[[ -n "${WORKLOG_NO_HOOK:-}" ]] && exit 0

cd "$(git rev-parse --show-toplevel)"

# Resolve through symlinks first: install-hooks.sh may have chained us
# in via a symlink at .git/hooks/post-commit (platform-owned outer
# core.hooksPath case) rather than pointing core.hooksPath straight at
# git-hooks/, so "$0" can be the symlink path rather than the real one.
SELF="$0"
while [[ -L "$SELF" ]]; do
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *)  SELF="$(dirname "$SELF")/$link" ;;
  esac
done
SKILL_BIN="$(cd "$(dirname "$SELF")/.." && pwd)"

STAMP=".cache/cross-task.stamp"
TTL=3600
mtime=$(stat -c %Y "$STAMP" 2>/dev/null || stat -f %m "$STAMP" 2>/dev/null || echo 0)
[[ "$mtime" =~ ^[0-9]+$ ]] || mtime=0
now=$(date +%s)
(( now - mtime > TTL )) || exit 0

# Two things this must not do: block the commit, and go quiet when the lint
# did not run. `2>/dev/null` plus `except Exception: pass` used to do the
# second -- a crashed lint, a missing dependency or unparseable JSON printed
# nothing, which is exactly what a clean repo prints. Stderr is kept and the
# parse failure is reported; the hook still always exits 0.
LINT_ERR="$(mktemp)"
"$SKILL_BIN/lint.sh" --cross-task --format=json 2>"$LINT_ERR" | LINT_ERR="$LINT_ERR" python3 -c "
import json, os, sys

raw = sys.stdin.read()
try:
  d = json.loads(raw)
  scanned = d['total_files']
except Exception as exc:
  detail = str(exc) if raw.strip() else 'lint.sh produced no output'
  try:
    with open(os.environ['LINT_ERR'], encoding='utf-8', errors='replace') as fh:
      tail = fh.read().strip().splitlines()[-1:]
  except OSError:
    tail = []
  if tail:
    detail = '%s (%s)' % (detail, tail[0])
  print(f'post-commit: cross-task lint SKIPPED — {detail}', file=sys.stderr)
  sys.exit(0)
e = d.get('total_errors', 0)
w = d.get('total_warnings', 0)
# Say WHOSE. This runs after committing one file but lints the whole repo, so
# a bare count reads as 'your commit caused these'. Most are pre-existing and
# in other people's tasks.
if e or w:
  print(f'post-commit: cross-task — {e} error(s), {w} warning(s) across {scanned} task file(s), repo-wide, not only this commit  (run $SKILL_BIN/lint.sh --cross-task to inspect)', file=sys.stderr)
# If any warning is the body-mention shape (the most common, repeatedly hit
# during 2026-04 sessions), suggest the auto-stub fix-up. Cheap one-line nudge
# at the moment of friction. See worklog-review-2026-04 Tier-1 #1.
body_mention = sum(
  1
  for item in d.get('issues', [])
  for warn in item.get('warnings', [])
  if 'body mentions slug' in warn
)
if body_mention:
  print(f'post-commit: {body_mention} of those are body-mention warning(s) — run $SKILL_BIN/lint.sh --fix-related to auto-stub', file=sys.stderr)
" || true
rm -f "$LINT_ERR"

mkdir -p .cache && touch "$STAMP"
exit 0
