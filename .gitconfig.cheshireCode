# Git identity overrides for repos owned by cheshireCode.
# Activated via `includeIf` in ~/.gitconfig, which matches the remote URL owner
# rather than a directory, so it applies from any checkout on any machine.
# install.sh links this file to ~/.gitconfig.cheshireCode.

[user]
	name = cheshireCode
	email = 1631630+cheshirecode@users.noreply.github.com
