# Example .envrc — copy to a directory above your fork checkouts and run
# `direnv allow`. Keeps OSS identity separate from $DAYJOB identity without
# storing PATs in plaintext.
#
# Lookup order for GH_TOKEN:
#   1. `gh auth token` (already authenticated via `gh auth login`)
#   2. `pass show github.com/<user>` (passwordstore.org)
#   3. macOS keychain (`security find-generic-password`)
#   4. ~/.env.secrets, key GH_TOKEN_<OWNER> (see templates/env.secrets.example)
# If none resolve, leaves GH_TOKEN unset so `gh` prompts you to log in.
#
# Never write a token into this file. Step 4 exists so that a machine with no
# keychain and no `pass` still has one documented place to put it, outside any
# checkout.

# Unset the work identity so it can't leak into pushes from this tree.
unset GITHUB_TOKEN

# Read ONE key from the machine-local credential file (~/.env.secrets, dotenv
# format; see templates/env.secrets.example). direnv ships `dotenv_if_exists`,
# which loads the WHOLE file, and that is the wrong tool here: every key would
# reach every tree below this file, and the per-tree split is the point.
#
# One reader only: bin/env-secret.sh. tests/shell/test_env_secret_reader.sh
# pins its key-selection contract. Set DOTFILES_DIR if the checkout is elsewhere.
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/Documents/oss/dotfiles}"
secret_get() {
  if [[ ! -x "$DOTFILES_DIR/bin/env-secret.sh" ]]; then
    # Absent reader and absent key are different states; say which.
    echo "direnv: $DOTFILES_DIR/bin/env-secret.sh not found; set DOTFILES_DIR" >&2
    return 1
  fi
  "$DOTFILES_DIR/bin/env-secret.sh" "$1"
}

resolve_gh_token() {
  if command -v gh >/dev/null 2>&1; then
    token=$(gh auth token 2>/dev/null || true)
    [[ -n "$token" ]] && { echo "$token"; return; }
  fi

  if command -v pass >/dev/null 2>&1; then
    token=$(pass show "github.com/${GITHUB_USER:-cheshirecode}" 2>/dev/null | head -1 || true)
    [[ -n "$token" ]] && { echo "$token"; return; }
  fi

  if [[ "$(uname -s)" == "Darwin" ]] && command -v security >/dev/null 2>&1; then
    token=$(security find-generic-password \
      -s "github.com" -a "${GITHUB_USER:-cheshirecode}" -w 2>/dev/null || true)
    [[ -n "$token" ]] && { echo "$token"; return; }
  fi

  # Last: the machine-local credential file. Deliberately below the keychain,
  # so a Mac keeps its secret out of cleartext while Linux and Coder
  # workspaces -- which have no keychain -- still resolve a token.
  local owner
  owner=$(printf '%s' "${GITHUB_USER:-cheshirecode}" | tr '[:lower:]' '[:upper:]')
  token=$(secret_get "GH_TOKEN_${owner}" || true)
  [[ -n "$token" ]] && { echo "$token"; return; }
}

if token=$(resolve_gh_token) && [[ -n "$token" ]]; then
  export GH_TOKEN="$token"
fi

# git author identity for this tree (don't rely on global config).
export GIT_AUTHOR_NAME="${GITHUB_USER:-cheshirecode}"
export GIT_AUTHOR_EMAIL="${GITHUB_USER:-cheshirecode}@users.noreply.github.com"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
