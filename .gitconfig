# Identity is injected, never hardcoded here. This file is shared by every
# machine, so it names only $HOME-relative paths:
#   ~/.gitconfig.local         per-machine identity and paths (untracked;
#                              install.sh bootstraps it)
#   ~/.gitconfig.cheshireCode  linked into $HOME by install.sh from whichever
#                              checkout ran it
#
# Measured 2026-09-16: this block pointed at
# `~/.config/coderv2/dotfiles/.gitconfig.cheshireCode`, a checkout path
# committed from a Coder workspace. On a machine whose checkout is elsewhere
# that file does not exist, and git ignores a missing include with NO error, so
# the identity silently never applied.
#
# Ownership is matched on the remote URL, not on a directory, so it holds from
# any checkout. Both patterns below are required and neither is redundant:
# git's glob is case-sensitive, and the scp-style SSH form puts the owner after
# a colon (`git@host:owner/repo`) while https puts it after a slash. Measured
# the same day against git 2.50.1: `**cheshirecode/**` matches the SSH form
# only, `**/cheshirecode/**` the https form only, and the previous
# `**/cheshireCode/**` matched neither, because the owner is lowercase in every
# real URL.
#
# Do not loosen these. An SSH host alias may itself carry the owner name (the
# `git@host-<owner>:` form), so a pattern that allows anything between the
# owner and the next slash also matches a repo owned by somebody else cloned
# through that alias, and would sign their commit with this identity. Measured
# 2026-09-16 against such an alias with a third-party owner:
# `**cheshirecode*/**` leaks; `**cheshirecode/**`, `**/cheshirecode/**`,
# `**cheshirecode**` and `*cheshirecode*` do not. The last two are safe but
# useless here, matching none of the real URLs either.
# tests/install/test_cheshirecode_identity.sh asserts both directions.
[include]
	path = ~/.gitconfig.local
[includeIf "hasconfig:remote.*.url:**cheshirecode/**"]
	path = ~/.gitconfig.cheshireCode
[includeIf "hasconfig:remote.*.url:**/cheshirecode/**"]
	path = ~/.gitconfig.cheshireCode
[rebase]
	# autosquash = true
[core]
	fscache = true
	autocrlf = input
	editor = code --wait
[pull]
	rebase = true
[diff]
  tool = default-difftool
[difftool "default-difftool"]
  cmd = code --wait --diff $LOCAL $REMOTE
[credential]
	helper = store
[alias]
	co = checkout
	lcl = log master..HEAD --pretty='format: - %s %H'
	l = log --all --decorate --oneline --graph
	lgr1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	lgr2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
	st = status -sb
	last = log -1 HEAD --stat
	cm = commit -m
	rv = remote -v
