# .envrc — OSS identity + worklog env vars

# source_up_if_exists, not source_up: install.sh links this file to ~/.envrc,
# and $HOME has no ancestor .envrc, so the bare form printed
# "direnv: No ancestor .envrc found" on every hook run in a new terminal.
source_up_if_exists
# Unset the work identity so it can't leak into pushes from this tree.
unset GITHUB_TOKEN

# Read ONE key from the machine-local credential file (~/.env.secrets, dotenv
# format; see templates/env.secrets.example). direnv ships `dotenv_if_exists`,
# which loads the WHOLE file, and that is the wrong tool here: this .envrc is
# symlinked to ~/.envrc and so runs for every directory under $HOME, work
# checkouts included. Loading every key there would undo the per-tree split
# that ~/Documents/*/.envrc exists to enforce.
#
# Duplicated from bin/env-secret.sh on purpose: ~/.envrc is a symlink and
# cannot resolve this repo's path. tests/shell/test_env_secret_reader.sh
# asserts the two agree; change both or neither.
secret_get() {
  local key="$1" candidate file="" value mode
  # /mnt/c/... is deliberately absent: DrvFs reports 0777 whatever you chmod,
  # so a credential there cannot be hidden from other accounts. Under WSL the
  # file belongs on the Linux filesystem.
  for candidate in "${ENV_SECRETS_FILE:-}" "$HOME/.env.secrets" "${USERPROFILE:-}/.env.secrets"; do
    [[ -n "$candidate" && -r "$candidate" ]] || continue
    file="$candidate"; break
  done
  [[ -n "$file" ]] || return 1
  mode=$(stat -f '%Lp' "$file" 2>/dev/null || stat -c '%a' "$file" 2>/dev/null || echo unknown)
  case "$mode" in
    600|400) ;;
    *) echo "direnv: $file is mode $mode, want 600 - run: chmod 600 $file" >&2 ;;
  esac
  # Anchored at line start, first match only: unanchored would also match
  # GH_TOKEN_CHESHIRECODE when asked for GH_TOKEN, and greedy would take the
  # last assignment rather than the first.
  value=$(sed -n "s/^[[:space:]]*${key}=//p" "$file" | head -1)
  value="${value%\"}"; value="${value#\"}"
  value="${value%\'}"; value="${value#\'}"
  value="${value%$'\r'}"   # a file edited on Windows carries a trailing CR
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

resolve_gh_token() {
  if command -v gh >/dev/null 2>&1; then
    token=$(gh auth token 2>/dev/null || true)
    [[ -n "$token" ]] && { echo "$token"; return; }
  fi

  if command -v pass >/dev/null 2>&1; then
    token=$(pass show "github.com/${GITHUB_USER:-cheshirecode}" 2>/dev/null | head -1 || true)
    [[ -n "$token" ]] && { echo "$token"; return; }
  fi

  if [[ "$(uname -s)" == "Darwin" ]] && command -v security >/dev/null 2>&1; then
    token=$(security find-generic-password \
      -s "github.com" -a "${GITHUB_USER:-cheshirecode}" -w 2>/dev/null || true)
    [[ -n "$token" ]] && { echo "$token"; return; }
  fi

  # Last: the machine-local credential file. Deliberately below the keychain,
  # so a Mac keeps its secret out of cleartext while Linux and Coder
  # workspaces -- which have no keychain -- still resolve a token.
  local owner
  owner=$(printf '%s' "${GITHUB_USER:-cheshirecode}" | tr '[:lower:]' '[:upper:]')
  token=$(secret_get "GH_TOKEN_${owner}" || true)
  [[ -n "$token" ]] && { echo "$token"; return; }
}

if token=$(resolve_gh_token) && [[ -n "$token" ]]; then
  export GH_TOKEN="$token"
fi

# No git identity is exported here. install.sh links this file to ~/.envrc, so
# direnv loads it for EVERY directory below $HOME, and direnv evaluates it with
# cwd at $HOME - it cannot tell which repo you are in. Exporting
# GIT_AUTHOR_NAME/EMAIL and GIT_COMMITTER_NAME/EMAIL here therefore applied one
# fixed identity to every checkout on the machine, work repos included, and
# environment beats git config, so the per-owner includeIf rules in .gitconfig
# could never take effect (measured 2026-09-16: a plain login shell reported the
# personal identity inside an unrelated repo).
#
# Identity now comes from git, which does know the repo: the owner-matched
# includeIf rules in .gitconfig, with ~/.gitconfig.local as the per-machine
# default. If git reports "Please tell me who you are" in a repo, that file is
# where the identity for it belongs - an empty identity is the intended
# behaviour, because signing a commit with the wrong name is worse than being
# asked for the right one.

# Worklog env vars (consumed by skills/worklog)
export WORKLOG_REPO="$HOME/Documents/oss/_worklog"
export WORKLOG_BIN="${WORKLOG_BIN:-$HOME/Documents/oss/dotfiles/skills/worklog/bin}"
export WORKLOG_LDAP="${WORKLOG_LDAP:-fredtran}"